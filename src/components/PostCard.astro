---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  showTags?: boolean;
}

const { post, showTags = true } = Astro.props;
const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="group flex flex-col justify-between rounded-xl border border-surface-border bg-surface-card p-6 shadow-sm transition-all duration-200 hover:border-brand-300 hover:shadow-md">
  <div>
    <div class="flex items-center gap-2 text-xs font-medium text-brand-600">
      <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
      {post.data.author && (
        <>
          <span aria-hidden="true">•</span>
          <span>{post.data.author}</span>
        </>
      )}
    </div>

    <h2 class="mt-2 text-xl font-bold tracking-tight text-content-primary transition-colors group-hover:text-brand-600">
      <a href={`/blog/${post.id}/`} class="focus:outline-none">
        {post.data.title}
      </a>
    </h2>

    <p class="mt-2 text-sm text-content-secondary line-clamp-3 leading-relaxed">
      {post.data.description}
    </p>
  </div>

  <div class="mt-4 pt-4 border-t border-surface-border flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    {showTags && post.data.tags.length > 0 ? (
      <div class="flex flex-wrap gap-1.5" aria-label="Tags">
        {post.data.tags.map((tag) => (
          <a
            href={`/blog/tag/${tag}/`}
            class="rounded-md bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700 transition hover:bg-brand-100 dark:bg-brand-950/70 dark:text-brand-300 dark:hover:bg-brand-900/60"
          >
            #{tag}
          </a>
        ))}
      </div>
    ) : <div />}

    <a
      href={`/blog/${post.id}/`}
      class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 transition-colors hover:text-brand-700"
      aria-label={`Read full article: ${post.data.title}`}
    >
      Read article <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</article>
