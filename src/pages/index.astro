---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/hero-illustration.svg';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const features = [
  {
    title: 'Zero Client-Side JS',
    description: 'Renders strictly static HTML & CSS by default. Ships 0kB JavaScript for ultimate load speed.',
    icon: '⚡',
  },
  {
    title: 'Hostinger Ready',
    description: 'Preconfigured Apache .htaccess with Gzip/Brotli compression, security headers, and clean URLs.',
    icon: '🚀',
  },
  {
    title: 'Design Tokens',
    description: 'Centralized CSS design tokens mapped cleanly to Tailwind utility classes in src/styles/tokens.css.',
    icon: '🎨',
  },
  {
    title: 'Type-Safe Content',
    description: 'Powered by Astro Content Collections and Zod validation for Markdown & MDX publishing.',
    icon: '📝',
  },
  {
    title: 'Optimized Media',
    description: 'Automatic responsive image optimization and format conversion with native astro:assets.',
    icon: '🖼️',
  },
  {
    title: 'SEO & Meta Tags',
    description: 'Complete OpenGraph, Twitter cards, sitemap.xml generation, and canonical URL structure.',
    icon: '🔍',
  },
];
---

<BaseLayout
  title="Home"
  description="High-performance, zero-JS Astro boilerplate preconfigured for static shared hosting."
>
  <!-- Hero Section -->
  <section class="border-b border-surface-border bg-gradient-to-b from-brand-50/50 via-surface-bg to-surface-bg py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
        <div>
          <span class="inline-flex items-center rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-700 dark:bg-brand-900/50 dark:text-brand-300">
            Astro Static Boilerplate
          </span>
          <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-content-primary sm:text-5xl lg:text-6xl">
            Ultra-fast static web, <span class="text-brand-600">zero bloat</span>.
          </h1>
          <p class="mt-4 text-lg text-content-secondary sm:text-xl">
            A production-ready foundation for publishing blazing fast websites to Hostinger or any static web host. No Node server required.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="/blog"
              class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2"
            >
              Explore Blog
            </a>
            <a
              href="/about"
              class="inline-flex items-center justify-center rounded-lg border border-surface-border bg-surface-card px-6 py-3 text-base font-semibold text-content-primary shadow-sm transition hover:bg-surface-border/50 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2"
            >
              About Project
            </a>
          </div>
        </div>

        <div class="flex justify-center">
          <div class="overflow-hidden rounded-2xl border border-surface-border bg-surface-card p-3 shadow-xl">
            <Image
              src={heroImage}
              alt="Astro Architecture Illustration"
              width={560}
              height={350}
              loading="eager"
              class="h-auto w-full rounded-xl object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-content-primary sm:text-4xl">
          Engineered for Performance
        </h2>
        <p class="mt-3 text-lg text-content-secondary">
          Everything you need to launch reproducible, maintainable static websites.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((feature) => (
            <div class="flex flex-col rounded-xl border border-surface-border bg-surface-card p-6 shadow-sm transition hover:border-brand-300 hover:shadow-md">
              <span class="text-3xl" aria-hidden="true">{feature.icon}</span>
              <h3 class="mt-4 text-xl font-bold text-content-primary">{feature.title}</h3>
              <p class="mt-2 text-sm text-content-secondary leading-relaxed">{feature.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Recent Articles -->
  {
    recentPosts.length > 0 && (
      <section class="border-t border-surface-border bg-surface-card/40 py-16 sm:py-20">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
            <div>
              <h2 class="text-3xl font-bold tracking-tight text-content-primary">Latest Articles</h2>
              <p class="mt-2 text-content-secondary">Fresh content straight from our collections.</p>
            </div>
            <a href="/blog" class="text-sm font-semibold text-brand-600 hover:text-brand-700">
              View all posts &rarr;
            </a>
          </div>

          <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
            {recentPosts.map((post) => (
              <article class="flex flex-col justify-between rounded-xl border border-surface-border bg-surface-card p-6 shadow-sm transition hover:border-brand-300 hover:shadow-md">
                <div>
                  <div class="text-xs font-semibold text-brand-600">
                    {post.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                  </div>
                  <h3 class="mt-2 text-lg font-bold text-content-primary">
                    <a href={`/blog/${post.id}/`} class="hover:text-brand-600">
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="mt-2 text-sm text-content-secondary line-clamp-3">
                    {post.data.description}
                  </p>
                </div>
                <div class="mt-4 pt-4 border-t border-surface-border">
                  <a
                    href={`/blog/${post.id}/`}
                    class="text-xs font-semibold text-brand-600 hover:underline"
                  >
                    Read article &rarr;
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
