---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Blog & Articles"
  description="Explore our latest thoughts, tutorials, and announcements."
>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-10 text-center sm:text-left">
      <h1 class="text-3xl font-extrabold tracking-tight text-content-primary sm:text-4xl">
        Articles & Updates
      </h1>
      <p class="mt-2 text-lg text-content-secondary">
        Guides and insights built with Astro and Markdown.
      </p>
    </header>

    <div class="space-y-6">
      {
        posts.map((post) => (
          <article class="rounded-xl border border-surface-border bg-surface-card p-6 shadow-sm transition-all hover:border-brand-300 hover:shadow-md">
            <div class="flex items-center gap-2 text-xs font-medium text-brand-600">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
              <span>•</span>
              <span>{post.data.author}</span>
            </div>
            <h2 class="mt-2 text-xl font-bold text-content-primary hover:text-brand-600">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="mt-2 text-sm text-content-secondary line-clamp-2">
              {post.data.description}
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="rounded-md bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700 dark:bg-brand-950 dark:text-brand-300">
                  #{tag}
                </span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>
