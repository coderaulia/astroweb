---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-8 border-b border-surface-border pb-8">
      <div class="flex items-center gap-2 text-sm font-medium text-brand-600">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        <span>•</span>
        <span>{post.data.author}</span>
      </div>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-content-primary sm:text-4xl">
        {post.data.title}
      </h1>
      <p class="mt-3 text-lg text-content-secondary">
        {post.data.description}
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <span class="rounded-md bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700 dark:bg-brand-950 dark:text-brand-300">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <div class="prose prose-slate max-w-none dark:prose-invert prose-headings:font-bold prose-a:text-brand-600">
      <Content />
    </div>

    <div class="mt-12 border-t border-surface-border pt-6">
      <a
        href="/blog/"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:text-brand-700"
      >
        &larr; Back to all articles
      </a>
    </div>
  </article>
</BaseLayout>
